<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36" version="26.2.12">
  <diagram name="第 1 页" id="ml7_rW7jHqD4-m7PgDsW">
    <mxGraphModel dx="788" dy="695" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dSdn5P25Ycu21THbmOjR-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="409.67" height="620" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-3" value="spec: Deployment的相关属性定义。&lt;div&gt;spec.selector: 是Deployment的Pod选择器，符合条件的pod实例受到该Deployment的管理，保证当前集群有且仅有一个pod实例在运行。&lt;/div&gt;&lt;div&gt;spec.template: 定义新生成一个pod实例的模板，当集群中运行的pod数少于replicas的时候，Deployment控制器会根据该pod模板生一个新的pod实例，spec.template.metadata.labels 指定了该pod的标签，labels必须匹配之前的spec.selector&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="510" y="120" width="260" height="240" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-4" value="&lt;div&gt;在master上运行下面的命令，完成发布&lt;/div&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;kubectl apply -f xxx-deploy.yaml&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;fontStyle=0;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="670" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-5" value="&lt;div&gt;在master上运行下面的命令，查看刚才创建的Deployment&lt;/div&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;kubectl get deploy&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;fontStyle=0;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="100" y="750" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-6" value="&lt;div&gt;在master上运行下面的命令，查看pod的创建情况&lt;/div&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;kubectl get pods&lt;/font&gt;" style="whiteSpace=wrap;html=1;align=left;fontStyle=0;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="830" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-7" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;在node节点上通过下面的命令可以查看容器&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;docker ps | grep mysql&lt;/font&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="100" y="900" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-8" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="100" y="980" width="405.08" height="190" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-9" value="除了mysql服务的pod容器之外，还多创建了一个pause容器，该容器就是pod的根容器。" style="whiteSpace=wrap;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="1180" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-11" value="" style="endArrow=classic;html=1;rounded=1;jumpSize=11;curved=0;strokeColor=default;endSize=10;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="240" y="1260" as="sourcePoint" />
            <mxPoint x="240" y="1350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-12" value="创建一个kubernates service" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=15;" vertex="1" connectable="0" parent="dSdn5P25Ycu21THbmOjR-11">
          <mxGeometry x="0.0444" y="3" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-13" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="90" y="1360" width="349.46" height="210" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-14" value="mysql-svc.yaml" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="450" y="1428" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-15" value="1. metadata.name 定义服务名称&lt;div&gt;2. spec.ports 定义service的虚端口&lt;/div&gt;&lt;div&gt;3. spec.selector 确定哪些pod（实例）对应本服务&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="90" y="1590" width="490" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-16" value="创建service对象，命令如下&lt;div&gt;&amp;nbsp;kubectl create -f mysql-svc.yaml&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="1680" width="490" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-19" value="查看service对象，命令如下&lt;div&gt;&amp;nbsp;kubectl get svc mysql&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="1760" width="490" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-20" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="90" y="1840" width="448" height="89.29" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-21" value="mysql服务被分配了一个10.245.161.22的clusterIP地址，集群中的其他&lt;div&gt;pod可以通过clusterIp+port的方式连接和访问该服务&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#b85450;fillColor=#f8cecc;fontSize=14;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="90" y="1935" width="460" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
