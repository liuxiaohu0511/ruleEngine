          <mxGeometry x="90" y="2020.0000000000002" width="552" height="130.57" as="geometry" />
        </mxCell>
        <mxCell id="dSdn5P25Ycu21THbmOjR-23" value="特别说明：k8s会自动将已经存在的Service对象以环境变量的形式展示在新生成的Pod中" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#d6b656;fillColor=#fff2cc;fontSize=14;" vertex="1" parent="1">
